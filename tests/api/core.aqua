# core and imgcodecs: Mat objects, arithmetic, channels, statistics, linear algebra and image files.
var cv = import("cv");
var count = 0;
var check = function(ok, name) { count += 1; if (!ok) { print("OPENCV CHECK FAILED", name); OpenCVCheckFailed(); } };
var near = function(a, b) { return a - b < 0.0001d && b - a < 0.0001d; };

var m = cv.Mat(2, 3, cv.CV_8UC3, [10, 20, 30]);
check(m.rows == 2 && m.cols == 3 && m.channels() == 3 && m.type() == cv.CV_8UC3, "Mat construction");
check(m.at(1, 2)[2] == 30 && m.shape()[2] == 3 && m.size()[0] == 3, "Mat element access");
m.set(0, 0, [1, 2, 3]);
check(m.at(0, 0)[0] == 1 && m.at(0, 1)[0] == 10, "Mat.set");
var a = cv.Mat([[1, 2], [3, 4]]);
check(a.type() == cv.CV_64F && near(cv.determinant(a), -2), "Mat from nested array and determinant");
var inverse = cv.invert(a);
check(near(inverse[1].at(0, 0), -2) && near(inverse[1].at(1, 1), -0.5d), "invert");
check(near(a.matmul(a.inv()).at(0, 0), 1) && near(a.t().at(0, 1), 3), "matmul, inv, t");
var solved = cv.solve(a, cv.Mat([5, 11]));
check(solved[0] && near(solved[1].at(0, 0), 1) && near(solved[1].at(1, 0), 2), "solve");
var eig = cv.eigen(cv.Mat([[2, 0], [0, 3]]));
check(eig[0] && near(eig[1].at(0, 0), 3), "eigen");

var b = cv.Mat(4, 4, cv.CV_8UC1, 100);
var c = cv.Mat(4, 4, cv.CV_8UC1, 200);
check(cv.add(b, c).at(0, 0) == 255 && cv.subtract(b, c).at(0, 0) == 0, "saturating add and subtract");
check(cv.absdiff(b, c).at(3, 3) == 100 && cv.addWeighted(b, 0.5d, c, 0.5d, 0).at(1, 1) == 150, "absdiff, addWeighted");
check(cv.bitwise_not(b).at(0, 0) == 155 && cv.bitwise_and(b, c).at(0, 0) == 64, "bitwise");
check(cv.countNonZero(cv.inRange(c, 150, 255)) == 16, "inRange and countNonZero");
var stats = cv.minMaxLoc(cv.Mat([[5, 1], [9, 3]]));
check(stats[0] == 1 && stats[1] == 9 && stats[2][0] == 1 && stats[3][1] == 1, "minMaxLoc");
var ms = cv.meanStdDev(cv.Mat([[2, 4], [4, 6]]));
check(near(ms[0][0], 4) && near(ms[1][0], 1.414213562d), "meanStdDev");
check(near(cv.mean(c)[0], 200) && near(cv.sum(b)[0], 1600) && near(cv.norm(cv.Mat([3, 4])), 5), "mean, sum, norm");

var color = cv.Mat(8, 8, cv.CV_8UC3, [255, 0, 0]);
var planes = cv.split(color);
check(len(planes) == 3 && planes[0].at(0, 0) == 255 && planes[2].at(0, 0) == 0, "split");
check(cv.merge([planes[2], planes[1], planes[0]]).at(0, 0)[2] == 255, "merge");
check(cv.flip(cv.Mat([[1, 2]]), 1).at(0, 0) == 2 && cv.rotate(cv.Mat([[1, 2]]), cv.ROTATE_90_CLOCKWISE).rows == 2, "flip, rotate");
check(cv.hconcat([b, c]).cols == 8 && cv.vconcat([b, c]).rows == 8, "hconcat, vconcat");
check(cv.copyMakeBorder(b, 1, 1, 2, 2, cv.BORDER_CONSTANT, 0).cols == 8, "copyMakeBorder");
var roi = color.roi([2, 2, 3, 3]);
roi.setTo([0, 255, 0]);
check(color.at(3, 3)[1] == 255 && color.at(0, 0)[1] == 0, "roi shares data");
var converted = b.convertTo(cv.CV_32F, 1.0d / 255);
check(converted.depth() == cv.CV_32F && near(converted.at(0, 0), 100.0d / 255), "convertTo");
var spectrum = cv.dft(cv.Mat([[1, 1], [1, 1]]).convertTo(cv.CV_32F), cv.DFT_COMPLEX_OUTPUT);
check(spectrum.channels() == 2 && near(spectrum.at(0, 0)[0], 4), "dft");
var points = cv.Mat([[0, 0], [0, 1], [10, 10], [10, 11]]).convertTo(cv.CV_32F);
var clusters = cv.kmeans(points, 2, cv.None, [cv.TERM_CRITERIA_EPS + cv.TERM_CRITERIA_MAX_ITER, 10, 1.0d], 3, cv.KMEANS_PP_CENTERS);
check(clusters[1].at(0, 0) == clusters[1].at(1, 0) && clusters[1].at(0, 0) != clusters[1].at(2, 0), "kmeans");
var pca = cv.PCACompute(cv.Mat([[1, 1], [2, 2], [3, 3]]));
check(near(pca[1].at(0, 0) * pca[1].at(0, 0), 0.5d), "PCACompute");

var encoded = cv.imencode(".png", color);
check(encoded[0] && len(encoded[1]) > 20, "imencode");
var decoded = cv.imdecode(encoded[1]);
check(decoded.rows == 8 && decoded.at(3, 3)[1] == 255, "imdecode round trip");
var portrait = cv.imread("/bottles/Aqua_OpenCV/assets/portrait.jpg");
check(!portrait.empty() && portrait.channels() == 3, "imread from an asset");
var gray = cv.imread("/bottles/Aqua_OpenCV/assets/portrait.jpg", cv.IMREAD_GRAYSCALE);
check(gray.channels() == 1 && gray.rows == portrait.rows, "imread grayscale");
var image = color.toImage();
check(image.width == 8 && cv.fromImage(image).at(3, 3)[1] == 255, "toImage and fromImage");
check(cv.Mat(8, 8, cv.CV_8UC3, [0, 0, 200]).toImage(image) == image && cv.fromImage(image).at(0, 0)[2] == 200, "toImage reuses an image");
check(len(color.data()) == 192 && len(cv.Mat([[1.5d, 2]]).toArray()[0]) == 2, "data and toArray");
check(cv.getVersionString() == "4.12.0", "version");
var failed = import("Network").Try(function() { cv.GaussianBlur(cv.Mat(4, 4, cv.CV_8UC1, 0), [4, 4], 0); });
check(!failed.Success, "OpenCV exceptions become script errors");
print("core checks", count);
