# 繁體中文別名：函式、方法與屬性皆與英文名稱共用同一個實作。
變數 視覺 = 匯入("電腦視覺");
變數 count = 0;
變數 檢查 = 函式(成立, 名稱) { count += 1; 如果 (!成立) { 印出("OPENCV CHECK FAILED", 名稱); 中文驗證失敗(); } };

變數 畫布 = 視覺.矩陣(120, 160, 視覺.CV_8UC3, [0, 0, 0]);
視覺.畫矩形(畫布, [20, 20], [70, 70], [255, 255, 255], 視覺.FILLED);
視覺.畫圓(畫布, [115, 60], 25, [0, 0, 255], -1);
變數 灰階 = 視覺.色彩轉換(畫布, 視覺.COLOR_BGR2GRAY);
檢查(灰階.列數 == 120 && 灰階.行數 == 160 && 灰階.通道數() == 1, "矩陣屬性");
變數 二值 = 視覺.二值化(灰階, 10, 255, 視覺.THRESH_BINARY);
變數 輪廓 = 視覺.尋找輪廓(二值[1], 視覺.RETR_EXTERNAL, 視覺.CHAIN_APPROX_SIMPLE)[0];
檢查(長度(輪廓) == 2, "尋找輪廓");
檢查(視覺.Canny邊緣(視覺.高斯模糊(灰階, [5, 5], 0), 50, 150).列數 == 120, "高斯模糊與 Canny");
變數 特徵 = 視覺.建立ORB(200).偵測並計算(灰階);
檢查(長度(特徵[0]) > 0 && 特徵[0][0]["大小"] > 0, "ORB 特徵點");
變數 檔案 = 視覺.編碼影像(".png", 畫布);
檢查(檔案[0] && 視覺.解碼影像(檔案[1]).行數 == 160, "影像編解碼");
檢查(視覺.版本() == 視覺.getVersionString(), "版本");
印出("bilingual checks", count);
