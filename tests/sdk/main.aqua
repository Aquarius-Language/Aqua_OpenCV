# 在實際編譯的 Aquarius Wasm 中驗證目前後端的每一項功能與影像生命週期。
變數 視覺=匯入("OpenCV");
變數 功能清單=匯入("功能清單.aqua");
變數 項目=功能清單.功能項目;
變數 陣列=匯入("陣列");
變數 資訊=視覺.功能支援();
視覺.載入人臉分類器("/bottles/Aqua_OpenCV/assets/face.xml");
如果(陣列.包含(資訊["功能"],"神經網路人臉")){視覺.載入神經網路("/bottles/Aqua_OpenCV/assets/yunet.onnx");}
變數 範例=視覺.範例影像(12);
變數 肖像=視覺.載入("/bottles/Aqua_OpenCV/assets/portrait.jpg");
變數 計數=0;
迴圈(變數 序號=0;序號<長度(項目);序號++){
    變數 名稱=項目[序號][0];
    如果(陣列.包含(資訊["功能"],名稱)){
        印出("OpenCV feature",名稱);
        變數 輸入=範例;如果(名稱=="人臉偵測" || 名稱=="神經網路人臉"){輸入=肖像;}
        變數 回應=視覺.處理(輸入,名稱,{"閾值":100,"核心大小":5});
        如果(!回應["成功"]){印出("OpenCV功能驗證失敗",名稱,回應["錯誤"],回應["診斷"]);功能驗證失敗;}
        變數 輸出=回應["結果"]["影像"];
        變數 尺寸=視覺.檢查(輸出);
        如果(尺寸["寬度"]<=0 || 尺寸["高度"]<=0){影像尺寸驗證失敗;}
        如果(名稱=="人臉偵測" || 名稱=="神經網路人臉"){如果(回應["結果"]["統計"]["人臉數"]<1){人臉偵測驗證失敗;}}
        如果(名稱=="QR碼編解碼" && 回應["結果"]["統計"]["解碼文字"]!="https://opencv.org"){QR碼解碼驗證失敗;}
        視覺.釋放影像(輸出);計數++;
    }
}
變數 PNG資料=視覺.編碼PNG(範例);
變數 解碼影像=視覺.解碼(PNG資料);
如果((視覺.檢查(解碼影像))["寬度"]!=480){影像編解碼驗證失敗;}
視覺.釋放影像(解碼影像);視覺.釋放影像(範例);視覺.釋放影像(肖像);
如果((視覺.功能支援())["影像數"]!=0){影像資源未釋放;}
視覺.釋放();印出("OpenCV功能驗證通過",計數);
