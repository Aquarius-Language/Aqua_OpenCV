變數 視覺=匯入("OpenCV");
變數 序列化=匯入("序列化");
變數 圖片=匯入("Images");
變數 範例=視覺.範例影像(12);
變數 英文=視覺.Apply(範例,"threshold",{"threshold":0,"kernel":5});
變數 中文=視覺.二值化(範例,{"閾值":0,"核心大小":5});
如果(!英文["ok"] || !中文["成功"]){雙語處理失敗;}
如果(中文["結果"]["統計"]["閾值"]!=0){零值參數失敗;}
變數 英文影像=圖片.解碼(視覺.EncodePNG(英文["value"]["image"]),0);
變數 中文影像=圖片.解碼(視覺.編碼PNG(中文["結果"]["影像"]),0);
如果(序列化.JSON序列化(英文影像.像素())!=序列化.JSON序列化(中文影像.像素())){雙語影像不一致;}
如果(中文["成功"]!=中文["ok"] || 中文["結果"]["影像"]!=中文["value"]["image"]){雙語結果不一致;}
視覺.釋放影像(英文["value"]["image"]);視覺.釋放影像(中文["結果"]["影像"]);
變數 尺寸回應=視覺.Resize(範例,{"寬度":123,"高度":77});
變數 尺寸=視覺.檢查(尺寸回應["結果"]["影像"]);
如果(尺寸["width"]!=123 || 尺寸["寬度"]!=123 || 尺寸["高度"]!=77){中文尺寸參數失敗;}
視覺.釋放影像(尺寸回應["結果"]["影像"]);
變數 失敗=視覺.高斯模糊(範例,{"核心大小":2});
如果(失敗["成功"] || 失敗["ok"] || !失敗["錯誤"] || !失敗["診斷"]){雙語錯誤結果失敗;}
變數 資訊=視覺.功能支援();
如果(長度(資訊["features"])!=長度(資訊["功能"]) || 資訊["optimized"]!=資訊["已最佳化"]){雙語功能資訊失敗;}
視覺.釋放影像(範例);視覺.釋放();印出("OpenCV雙語驗證通過");
