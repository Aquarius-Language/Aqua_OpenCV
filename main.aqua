變數 Dynamic = 匯入("DynamicLibrary");
變數 JSON = 匯入("Serialization");
變數 Files = 匯入("Files");
變數 Images = 匯入("Images");
變數 Arrays = 匯入("Array");
變數 Math = 匯入("Processing");
變數 Platforms = 匯入(目前工作目錄 + "/platforms.aqua");
變數 PlatformPaths = Platforms.Libraries;
變數 LibraryPath=PlatformPaths[Dynamic.Platform];
如果(Dynamic.Platform!="android" || LibraryPath!="libaqua_opencv.so"){LibraryPath=目前工作目錄+LibraryPath;}
變數 Engine = Dynamic.Load(LibraryPath);
變數 UseNative = !Engine.HasSymbol("cv_write");
變數 Session = (JSON.ParseJson(Engine.Call("cv_command", JSON.Json({"op":"open"}))))["value"];
變數 Closed = 假;
變數 Command = 函式(request) { request["session"] = Session; 回傳 JSON.ParseJson(Engine.Call("cv_command", JSON.Json(request))); };
變數 Bytes32 = 函式(id) {
    變數 bytes = [];
    迴圈(變數 i=0;i<4;i++){變數 b=id-Math.floor(id/256.0d)*256;Arrays.Append(bytes,b);id=(id-b)/256;}
    回傳 bytes;
};

# Public feature names are accepted in either language on every backend.
變數 FeatureNames = [["gray", "灰階"], ["hsv", "HSV色彩空間"], ["gaussian", "高斯模糊"], ["median", "中值濾波"], ["bilateral", "雙邊濾波"], ["canny", "Canny邊緣"], ["sobel", "Sobel梯度"], ["laplacian", "Laplacian邊緣"], ["threshold", "二值化"], ["adaptive", "自適應二值化"], ["otsu", "Otsu二值化"], ["erode", "侵蝕"], ["dilate", "膨脹"], ["open", "開運算"], ["close", "閉運算"], ["gradient", "形態學梯度"], ["equalize", "直方圖等化"], ["clahe", "局部對比增強"], ["colormap", "偽彩色映射"], ["resize", "調整影像大小"], ["rotate", "仿射旋轉"], ["perspective", "透視轉換"], ["contours", "輪廓偵測"], ["hough_lines", "霍夫直線"], ["hough_circles", "霍夫圓形"], ["corners", "角點偵測"], ["orb", "ORB特徵"], ["sift", "SIFT特徵"], ["matching", "特徵匹配"], ["template", "樣板匹配"], ["watershed", "分水嶺分割"], ["grabcut", "GrabCut前景"], ["kmeans", "K平均量化"], ["dft", "傅立葉頻譜"], ["inpaint", "影像修補"], ["denoise", "非局部均值去噪"], ["optical_flow", "稠密光流"], ["background", "背景相減"], ["face", "人臉偵測"], ["qr", "QR碼編解碼"], ["stereo", "立體視差"], ["homography", "單應性估計"], ["calibration", "相機姿態估計"], ["stitching", "全景拼接"], ["dnn", "神經網路人臉"]];
變數 功能名稱 = FeatureNames;
變數 無值 = JSON.ParseJson("null");
變數 欄位對照 = [["width","寬度"],["height","高度"],["channels","通道數"],["version","版本"],["threads","執行緒數"],["optimized","已最佳化"],["simd","SIMD"],["openclAvailable","OpenCL可用"],["openclEnabled","OpenCL已啟用"],["images","影像數"]];
變數 統計對照 = [["threshold","閾值"],["contours","輪廓數"],["lines","線段數"],["circles","圓形數"],["corners","角點數"],["keypoints","特徵點數"],["matches","匹配數"],["inliers","內點數"],["score","相似度"],["segments","區域數"],["clusters","群集數"],["pair","平移像素"],["faces","人臉數"],["text","解碼文字"],["input","輸入說明"],["solved","已求解"],["z","深度"],["status","狀態碼"],["model","模型"],["correspondences","對應點數"]];
變數 補齊中文欄位 = 函式(資料) {
    迴圈(變數 序號=0;序號<長度(欄位對照);序號++){
        變數 對照=欄位對照[序號];如果(資料[對照[0]]!=無值){資料[對照[1]]=資料[對照[0]];}
    }
    回傳 資料;
};
變數 英文功能 = 函式(名稱) {
    迴圈(變數 序號=0;序號<長度(功能名稱);序號++){
        變數 對照=功能名稱[序號];如果(名稱==對照[1]){回傳 對照[0];}
    }
    回傳 名稱;
};
變數 中文參數 = 函式(參數) {
    變數 複本={};如果(參數!=無值){複本=JSON.ParseJson(JSON.Json(參數));}
    變數 對照表=[["閾值","threshold"],["核心大小","kernel"],["角度","angle"],["寬度","width"],["高度","height"]];
    迴圈(變數 序號=0;序號<長度(對照表);序號++){
        變數 對照=對照表[序號];如果(複本[對照[0]]!=無值){複本[對照[1]]=複本[對照[0]];}
    }
    回傳 複本;
};
變數 雙語結果 = 函式(回應) {
    回應["成功"]=回應["ok"];
    如果(回應["ok"]){
        變數 資料=回應["value"];回應["結果"]=資料;
        如果(資料["image"]!=無值){
            資料["影像"]=資料["image"];資料["毫秒"]=資料["milliseconds"];
            變數 統計={};變數 原始統計=資料["stats"];
            迴圈(變數 序號=0;序號<長度(統計對照);序號++){
                變數 對照=統計對照[序號];如果(原始統計[對照[0]]!=無值){統計[對照[1]]=原始統計[對照[0]];}
            }
            如果(統計["輸入說明"]=="synthetic rectified pair, 8px shift"){統計["輸入說明"]="合成校正雙目影像，平移 8 像素";}
            如果(統計["輸入說明"]=="two overlapping views with deterministic texture"){統計["輸入說明"]="兩張具有固定紋理的重疊影像";}
            資料["統計"]=統計;
        }
    }否則{回應["錯誤"]="影像處理失敗，請檢查功能、參數及影像內容。";回應["診斷"]=回應["error"];}
    回傳 回應;
};

變數 Capabilities, 功能支援 = 函式() { 變數 資料=補齊中文欄位(Command({"op":"info"})["value"]);變數 功能=[];
    迴圈(變數 序號=0;序號<長度(功能名稱);序號++){變數 對照=功能名稱[序號];如果(Arrays.Contains(資料["features"],對照[0])){Arrays.Append(功能,對照[1]);}}
    資料["功能"]=功能;資料["後端"]="OpenCV.js / WebAssembly SIMD128";如果(UseNative){資料["後端"]="原生 C++ / SIMD 指令派送 / 平行運算";}回傳 資料; };
變數 Configure, 設定 = 函式(threads) { 變數 回應=Command({"op":"configure","threads":threads});回應["成功"]=回應["ok"];回應["結果"]=回應["value"];如果(!回應["ok"]){回應["錯誤"]="執行緒數必須介於 1 到 256。";回應["診斷"]=回應["error"];}回傳 回應; };
變數 Sample, 範例影像 = 函式(frame) { 回傳 Command({"op":"sample","frame":frame})["value"]; };
變數 Inspect, 檢查 = 函式(image) { 回傳 補齊中文欄位(Command({"op":"inspect","image":image})["value"]); };
變數 Apply, 處理 = 函式(image, feature, parameters) { 回傳 雙語結果(Command({"op":"apply","image":image,"feature":英文功能(feature),"parameters":中文參數(parameters)})); };
變數 Release, 釋放影像 = 函式(image) { 變數 回應=Command({"op":"release","image":image});回應["成功"]=回應["ok"];回應["結果"]=回應["value"];如果(!回應["ok"]){回應["錯誤"]="無法釋放影像，請確認影像代碼仍有效。";回應["診斷"]=回應["error"];}回傳 回應; };
變數 Decode, 解碼 = 函式(bytes) {
    如果(UseNative){
        變數 input = Bytes32(Session); Arrays.AppendArray(input, bytes);
        變數 id = Engine.Invoke("cv_decode", input);
        回傳 id[0] + id[1]*256 + id[2]*65536 + id[3]*16777216;
    }
    變數 decoded=Images.Decode(bytes,0);
    變數 id=Command({"op":"rgba","width":decoded.width,"height":decoded.height})["value"];
    變數 pixels=decoded.Pixels();
    迴圈(變數 offset=0;offset<長度(pixels);offset+=1048560){
        變數 count=長度(pixels)-offset;如果(count>1048560){count=1048560;}
        變數 input=Bytes32(Session);Arrays.AppendArray(input,Bytes32(id));Arrays.AppendArray(input,Bytes32(offset));Arrays.AppendArray(input,Arrays.Slice(pixels,offset,offset+count));Engine.Invoke("cv_write",input);
    }
    回傳 id;
};
變數 Load, 載入 = 函式(path) { 回傳 Decode(Files.ReadAssetBytes(path)); };
變數 EncodePNG, 編碼PNG = 函式(image) {
    如果(UseNative){變數 input=Bytes32(Session);Arrays.AppendArray(input,Bytes32(image));回傳 Engine.Invoke("cv_png",input);}
    變數 dimensions=Inspect(image);變數 length=dimensions["width"]*dimensions["height"]*4;變數 pixels=[];
    迴圈(變數 offset=0;offset<length;offset+=1048576){
        變數 count=length-offset;如果(count>1048576){count=1048576;}
        變數 input=Bytes32(Session);Arrays.AppendArray(input,Bytes32(image));Arrays.AppendArray(input,Bytes32(offset));Arrays.AppendArray(input,Bytes32(count));Arrays.AppendArray(pixels,Engine.Invoke("cv_pixels",input));
    }
    回傳 Images.Encode(Images.Create(dimensions["width"],dimensions["height"],pixels),"Png",{});
};
變數 Upload = 函式(kind,path) { 變數 input=Bytes32(Session);Arrays.Append(input,kind);Arrays.AppendArray(input,Files.ReadAssetBytes(path));回傳 Engine.Invoke("cv_upload",input); };
變數 LoadCascade, 載入人臉分類器 = 函式(path) { 回傳 Upload(1,path); };
變數 LoadYuNet, 載入神經網路 = 函式(path) { 回傳 Upload(2,path); };
變數 Preview, 預覽 = 函式(image) {
    變數 Window=匯入("Window");變數 dimensions=Inspect(image);變數 preview=image;變數 temporary=假;
    如果(dimensions["width"]>480 || dimensions["height"]>300){
        變數 factor=Math.min(480.0d/dimensions["width"],300.0d/dimensions["height"]);
        變數 resized=Apply(image,"resize",{"width":Math.max(1,Math.floor(dimensions["width"]*factor)),"height":Math.max(1,Math.floor(dimensions["height"]*factor))});preview=resized["value"]["image"];temporary=真;
    }
    變數 result=Window.ToProcessingImage(Images.Decode(EncodePNG(preview),0));如果(temporary){Release(preview);}回傳 result;
};
變數 Dispose, 釋放 = 函式() { 如果(!Closed){Command({"op":"close"});Engine.Dispose();Closed=真;} };

# Convenience functions share the same bilingual Apply result and parameter map.
變數 Grayscale, 灰階 = 函式(影像, 參數) { 回傳 處理(影像,"gray",參數); };
變數 HSV, HSV色彩空間 = 函式(影像, 參數) { 回傳 處理(影像,"hsv",參數); };
變數 GaussianBlur, 高斯模糊 = 函式(影像, 參數) { 回傳 處理(影像,"gaussian",參數); };
變數 MedianBlur, 中值濾波 = 函式(影像, 參數) { 回傳 處理(影像,"median",參數); };
變數 BilateralFilter, 雙邊濾波 = 函式(影像, 參數) { 回傳 處理(影像,"bilateral",參數); };
變數 Canny, Canny邊緣 = 函式(影像, 參數) { 回傳 處理(影像,"canny",參數); };
變數 Sobel, Sobel梯度 = 函式(影像, 參數) { 回傳 處理(影像,"sobel",參數); };
變數 Laplacian, Laplacian邊緣 = 函式(影像, 參數) { 回傳 處理(影像,"laplacian",參數); };
變數 Threshold, 二值化 = 函式(影像, 參數) { 回傳 處理(影像,"threshold",參數); };
變數 AdaptiveThreshold, 自適應二值化 = 函式(影像, 參數) { 回傳 處理(影像,"adaptive",參數); };
變數 OtsuThreshold, Otsu二值化 = 函式(影像, 參數) { 回傳 處理(影像,"otsu",參數); };
變數 Erode, 侵蝕 = 函式(影像, 參數) { 回傳 處理(影像,"erode",參數); };
變數 Dilate, 膨脹 = 函式(影像, 參數) { 回傳 處理(影像,"dilate",參數); };
變數 MorphologicalOpen, 開運算 = 函式(影像, 參數) { 回傳 處理(影像,"open",參數); };
變數 MorphologicalClose, 閉運算 = 函式(影像, 參數) { 回傳 處理(影像,"close",參數); };
變數 MorphologicalGradient, 形態學梯度 = 函式(影像, 參數) { 回傳 處理(影像,"gradient",參數); };
變數 EqualizeHistogram, 直方圖等化 = 函式(影像, 參數) { 回傳 處理(影像,"equalize",參數); };
變數 CLAHE, 局部對比增強 = 函式(影像, 參數) { 回傳 處理(影像,"clahe",參數); };
變數 ColorMap, 偽彩色映射 = 函式(影像, 參數) { 回傳 處理(影像,"colormap",參數); };
變數 Resize, 調整影像大小 = 函式(影像, 參數) { 回傳 處理(影像,"resize",參數); };
變數 Rotate, 仿射旋轉 = 函式(影像, 參數) { 回傳 處理(影像,"rotate",參數); };
變數 Perspective, 透視轉換 = 函式(影像, 參數) { 回傳 處理(影像,"perspective",參數); };
變數 Contours, 輪廓偵測 = 函式(影像, 參數) { 回傳 處理(影像,"contours",參數); };
變數 HoughLines, 霍夫直線 = 函式(影像, 參數) { 回傳 處理(影像,"hough_lines",參數); };
變數 HoughCircles, 霍夫圓形 = 函式(影像, 參數) { 回傳 處理(影像,"hough_circles",參數); };
變數 Corners, 角點偵測 = 函式(影像, 參數) { 回傳 處理(影像,"corners",參數); };
變數 ORB, ORB特徵 = 函式(影像, 參數) { 回傳 處理(影像,"orb",參數); };
變數 SIFT, SIFT特徵 = 函式(影像, 參數) { 回傳 處理(影像,"sift",參數); };
變數 MatchDescriptors, 特徵匹配 = 函式(影像, 參數) { 回傳 處理(影像,"matching",參數); };
變數 MatchTemplate, 樣板匹配 = 函式(影像, 參數) { 回傳 處理(影像,"template",參數); };
變數 Watershed, 分水嶺分割 = 函式(影像, 參數) { 回傳 處理(影像,"watershed",參數); };
變數 GrabCut, GrabCut前景 = 函式(影像, 參數) { 回傳 處理(影像,"grabcut",參數); };
變數 KMeans, K平均量化 = 函式(影像, 參數) { 回傳 處理(影像,"kmeans",參數); };
變數 FourierSpectrum, 傅立葉頻譜 = 函式(影像, 參數) { 回傳 處理(影像,"dft",參數); };
變數 Inpaint, 影像修補 = 函式(影像, 參數) { 回傳 處理(影像,"inpaint",參數); };
變數 Denoise, 非局部均值去噪 = 函式(影像, 參數) { 回傳 處理(影像,"denoise",參數); };
變數 OpticalFlow, 稠密光流 = 函式(影像, 參數) { 回傳 處理(影像,"optical_flow",參數); };
變數 BackgroundSubtraction, 背景相減 = 函式(影像, 參數) { 回傳 處理(影像,"background",參數); };
變數 DetectFaces, 人臉偵測 = 函式(影像, 參數) { 回傳 處理(影像,"face",參數); };
變數 QRCode, QR碼編解碼 = 函式(影像, 參數) { 回傳 處理(影像,"qr",參數); };
變數 StereoDisparity, 立體視差 = 函式(影像, 參數) { 回傳 處理(影像,"stereo",參數); };
變數 Homography, 單應性估計 = 函式(影像, 參數) { 回傳 處理(影像,"homography",參數); };
變數 CameraPose, 相機姿態估計 = 函式(影像, 參數) { 回傳 處理(影像,"calibration",參數); };
變數 StitchPanorama, 全景拼接 = 函式(影像, 參數) { 回傳 處理(影像,"stitching",參數); };
變數 DetectFacesDNN, 神經網路人臉 = 函式(影像, 參數) { 回傳 處理(影像,"dnn",參數); };
