// OpenCV constants under their cv2 names. CV(name) is cv::name; RAW(name) is a C macro; NS(name, value) is a constant
// of a submodule (ml, aruco, dnn), flattened onto the module under the name cv2 uses inside that submodule.
// OpenCV 常數，名稱與 cv2 相同。

// Depths and types.
RAW(CV_8U) RAW(CV_8S) RAW(CV_16U) RAW(CV_16S) RAW(CV_32S) RAW(CV_32F) RAW(CV_64F) RAW(CV_16F)
RAW(CV_8UC1) RAW(CV_8UC2) RAW(CV_8UC3) RAW(CV_8UC4) RAW(CV_8SC1) RAW(CV_8SC2) RAW(CV_8SC3) RAW(CV_8SC4)
RAW(CV_16UC1) RAW(CV_16UC2) RAW(CV_16UC3) RAW(CV_16UC4) RAW(CV_16SC1) RAW(CV_16SC2) RAW(CV_16SC3) RAW(CV_16SC4)
RAW(CV_32SC1) RAW(CV_32SC2) RAW(CV_32SC3) RAW(CV_32SC4) RAW(CV_32FC1) RAW(CV_32FC2) RAW(CV_32FC3) RAW(CV_32FC4)
RAW(CV_64FC1) RAW(CV_64FC2) RAW(CV_64FC3) RAW(CV_64FC4)

